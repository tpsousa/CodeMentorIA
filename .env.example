# Copie para .env e preencha. NUNCA versione o arquivo .env.

# --- Opção recomendada: Groq (gratuito) -> https://console.groq.com
AI_BASE_URL=https://api.groq.com/openai
AI_COMPLETIONS_PATH=/v1/chat/completions
AI_API_KEY=sua-chave-groq
AI_MODEL=llama-3.3-70b-versatile

# --- Alternativa: Google Gemini (gratuito) -> https://aistudio.google.com
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_COMPLETIONS_PATH=/chat/completions
# AI_API_KEY=sua-chave-gemini
# AI_MODEL=gemini-2.0-flash

# --- Alternativa: Ollama local (offline, sem chave) -> https://ollama.com
# AI_BASE_URL=http://localhost:11434
# AI_COMPLETIONS_PATH=/v1/chat/completions
# AI_API_KEY=ollama
# AI_MODEL=qwen2.5-coder:7b

RATE_LIMIT_RPM=10
